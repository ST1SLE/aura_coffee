upstream api {
    server core-api:8000;
}

upstream payment_webhook {
    server payment-webhook:8241;
}

log_format aura_no_query '$remote_addr - $remote_user [$time_local] '
                         '"$request_method $uri $server_protocol" $status $body_bytes_sent '
                         '"$http_referer" "$http_user_agent"';
access_log /var/log/nginx/access.log aura_no_query;

map_hash_bucket_size 128;

map $cookie_aura_staging $aura_basic_auth_realm {
    default ${AURA_BASIC_AUTH_REALM};
    "${AURA_STAGING_ACCESS_COOKIE}" off;
}

map $remote_user $aura_staging_set_cookie {
    default "";
    aura "aura_staging=${AURA_STAGING_ACCESS_COOKIE}; Path=/; Max-Age=604800; Secure; HttpOnly; SameSite=Lax";
}

server {
    listen 80;
    server_name ${AURA_PUBLIC_DOMAIN};

    absolute_redirect off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${AURA_PUBLIC_DOMAIN};

    absolute_redirect off;
    client_max_body_size 10m;

    ssl_certificate /etc/letsencrypt/live/${AURA_PUBLIC_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${AURA_PUBLIC_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    auth_basic $aura_basic_auth_realm;
    auth_basic_user_file ${AURA_BASIC_AUTH_USER_FILE};
    add_header Set-Cookie $aura_staging_set_cookie always;

    # Readiness probe through the canonical nginx entry point.
    location = /health {
        proxy_pass http://api/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # YuKassa webhook ingress must terminate at payment-worker, not core-api.
    location = /api/webhooks/yukassa {
        proxy_pass http://payment_webhook/webhooks/yukassa;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://api;
        proxy_http_version 1.1;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /media/menu/ {
        alias /srv/aura-coffee/media/menu/;
        try_files $uri =404;
        access_log off;
        expires 7d;
        add_header Cache-Control "public, max-age=604800" always;
    }

    location = /admin {
        return 301 /admin/;
    }

    location /admin/assets/ {
        alias /usr/share/nginx/html/admin/assets/;
        try_files $uri =404;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable" always;
    }

    location /admin/ {
        alias /usr/share/nginx/html/admin/;
        try_files $uri $uri/ /admin/index.html;
    }

    location /assets/ {
        root /usr/share/nginx/html;
        try_files $uri =404;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable" always;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
