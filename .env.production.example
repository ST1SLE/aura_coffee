# Copy to .env.production on the server and replace every REPLACE_* value.
# Keep this file secret-free. Do not commit the real .env.production file.

# App environment
AURA_ENV=production

# PostgreSQL
POSTGRES_USER=aura_prod
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=aura_coffee
DATABASE_URL=postgresql://aura_prod:REPLACE_WITH_STRONG_POSTGRES_PASSWORD@postgres:5432/aura_coffee

# Redis
REDIS_URL=redis://redis:6379/0
CART_TTL_SECONDS=86400

# Public origin
CORS_ORIGINS=https://staging.aura-coffee-bakery.ru
AURA_PUBLIC_DOMAIN=staging.aura-coffee-bakery.ru

# Auth and PII encryption
JWT_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_48
ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32_64_CHARS

# Stage 1 provider posture: safe skeleton only, no real provider calls.
SMS_BACKEND=log
SMSRU_API_KEY=

YANDEX_MAPS_SUGGEST_API_KEY=
YANDEX_MAPS_GEOCODER_API_KEY=
YANDEX_MAPS_API_KEY=

YUKASSA_BACKEND=fake
YUKASSA_SHOP_ID=stage-fake-shop
YUKASSA_SECRET_KEY=stage-fake-secret
YUKASSA_BASE_URL=https://api.yookassa.ru/v3
YUKASSA_WEBHOOK_IPS=127.0.0.1,payment-worker,payment-webhook
YUKASSA_WEBHOOK_SIGNATURE_SECRET=
YUKASSA_WEBHOOK_SIGNATURE_HEADER=X-YooKassa-Signature
YUKASSA_FAKE_OUTCOME=success

# Public nginx entry point. Use scripts/production/compose.sh --tls after
# issuing a certificate for AURA_PUBLIC_DOMAIN.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
AURA_CERTBOT_WWW_DIR=/opt/aura-coffee/certbot-www
AURA_LETSENCRYPT_DIR=/etc/letsencrypt
AURA_STAGING_ACCESS_COOKIE=REPLACE_WITH_OPENSSL_RAND_HEX_32
AURA_STAGING_HTPASSWD_FILE=/opt/aura-coffee/staging.htpasswd

# Production media source mounted read-only into nginx.
AURA_MENU_MEDIA_DIR=/srv/aura-coffee/media/menu

# Initial admin seed. Replace before first staging boot.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ONE_TIME_ADMIN_PASSWORD
